# =============================================================================
# RRTrack — variáveis de ambiente
#
# REGRA DO PROJETO: aqui mora SÓ a infraestrutura do Supabase. Nada de tokens
# da Meta, api_secret do GA4 ou token de webhook — esses são cadastrados pelo
# PAINEL e ficam cifrados no banco. Ver CLAUDE.md › Credenciais.
#
# Copie para `.env.local` (já ignorado pelo git) e preencha.
# =============================================================================

# URL do projeto Supabase. Pública por natureza.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave anônima/publicável. Vai para o navegador — por isso TODA tabela tem RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ SEGREDO. Ignora RLS por completo.                                       │
# │ NUNCA com prefixo NEXT_PUBLIC_. NUNCA importada em componente cliente.  │
# │ Só em Route Handlers e Server Actions, via src/lib/supabase/admin.ts.   │
# └─────────────────────────────────────────────────────────────────────────┘
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx
