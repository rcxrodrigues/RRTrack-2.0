{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "pedantic": "off"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    // JSX transform novo (jsx: "react-jsx"): React não precisa estar em escopo.
    "react/react-in-jsx-scope": "off",
    // `import './globals.css'` é um efeito colateral legítimo.
    "import/no-unassigned-import": "off",

    "no-console": ["error", { "allow": ["warn", "error"] }],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "eqeqeq": ["error", "smart"]
  },
  "ignorePatterns": [".next/**", "node_modules/**", "next-env.d.ts", "supabase/**"],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-console": "off",
        "no-constant-binary-expression": "off"
      }
    }
  ]
}
